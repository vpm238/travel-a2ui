---
// The primary way through the quickstart: one line for a coding agent.
//
// The prompt is deliberately almost nothing. Everything the agent needs (how
// to guide, the setup steps, what to explain and where it is in the code)
// lives behind the URL, in `src/prompts/quickstart.md`, so it can improve
// without anyone re-copying a prompt.
import { Code } from '@astrojs/starlight/components';
import { absolute, local, PROMPT_PATH, bootstrapPrompt } from '../site';
---

<section class="agent-prompt" aria-labelledby="agent-prompt-title">
  <span class="agent-prompt__eyebrow">Start here</span>
  <h2 id="agent-prompt-title">Paste this into your coding agent</h2>
  <Code code={bootstrapPrompt()} lang="text" wrap />
  <p class="agent-prompt__note">
    Works in Claude Code, Gemini CLI, Codex, Cursor or any agent that can read a web page. It sets
    up the Python server, then the React client, then the Flutter client, and explains each one as
    it starts working. No API key is needed to begin.
  </p>
  <ul class="agent-prompt__links" aria-label="Machine-readable versions">
    <li><a href={local(PROMPT_PATH)}>What your agent reads</a></li>
    <li><a href={local('quickstart.md')}>This page as Markdown</a></li>
    <li><a href={local('llms.txt')}>llms.txt</a></li>
  </ul>
</section>

<style>
  .agent-prompt {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 1rem;
    background: var(--qs-prompt-bg);
  }
  .agent-prompt h2 {
    margin: 0.15rem 0 0.75rem;
    font-size: var(--sl-text-h3);
  }
  .agent-prompt__eyebrow {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }
  .agent-prompt__note {
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .agent-prompt__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
  }
  .agent-prompt__links li {
    margin: 0;
  }
</style>
