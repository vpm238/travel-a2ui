---
// The primary way through the quickstart: hand the tour to a coding agent.
//
// Three ways in, because agents differ in what they can do. Anything that can
// fetch a URL gets one line pointing at the prompt; the terminal agents get a
// command that pipes the prompt straight in; and the whole prompt is here to
// copy for anything else. One source for all three: `src/prompts/quickstart.md`.
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
import prompt from '../prompts/quickstart.md?raw';
import { absolute, local, PROMPT_PATH, bootstrapPrompt } from '../site';

const url = absolute(PROMPT_PATH);
const fetchIt = `"$(curl -fsSL ${url})"`;
---

<section class="agent-prompt" aria-labelledby="agent-prompt-title">
  <div class="agent-prompt__head">
    <span class="agent-prompt__eyebrow">Recommended</span>
    <h2 id="agent-prompt-title">Take the tour with your coding agent</h2>
    <p>
      Give this to Claude Code, Gemini CLI, Codex, Cursor or any coding agent. It clones the
      demo, runs it on your machine and walks you through the code one concept at a time. It
      pauses after each step so you can ask questions. No API key needed for the core tour.
    </p>
  </div>

  <Tabs syncKey="coding-agent">
    <TabItem label="Any agent">
      <p class="agent-prompt__hint">Paste this into any agent that can read a web page:</p>
      <Code code={bootstrapPrompt()} lang="text" wrap />
    </TabItem>
    <TabItem label="Claude Code">
      <Code code={`claude ${fetchIt}`} lang="bash" wrap />
    </TabItem>
    <TabItem label="Gemini CLI">
      <Code code={`gemini -i ${fetchIt}`} lang="bash" wrap />
    </TabItem>
    <TabItem label="Codex">
      <Code code={`codex ${fetchIt}`} lang="bash" wrap />
    </TabItem>
  </Tabs>

  <details class="agent-prompt__full">
    <summary>See the whole prompt</summary>
    <p class="agent-prompt__hint">
      Copy it into an agent that cannot fetch URLs, or read it to see exactly what your agent
      will do. Also served raw at <a href={local(PROMPT_PATH)}>{PROMPT_PATH}</a>.
    </p>
    <Code code={prompt} lang="md" wrap />
  </details>
</section>

<style>
  .agent-prompt {
    margin-top: 1.5rem;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 1rem;
    background: var(--qs-prompt-bg);
  }
  .agent-prompt__head h2 {
    margin: 0.15rem 0 0.4rem;
    font-size: var(--sl-text-h3);
  }
  .agent-prompt__head p {
    margin: 0;
    color: var(--sl-color-gray-2);
  }
  .agent-prompt__eyebrow {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }
  .agent-prompt__hint {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .agent-prompt__full {
    margin-top: 1rem;
  }
  .agent-prompt__full summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--sl-color-accent-high);
  }
  .agent-prompt__full[open] summary {
    margin-bottom: 0.5rem;
  }
  .agent-prompt__full :global(.expressive-code pre) {
    max-height: 26rem;
    overflow: auto;
  }
</style>
