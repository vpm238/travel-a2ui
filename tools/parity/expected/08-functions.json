[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "parity-surface",
      "catalogId": "https://travel-a2ui.dev/catalogs/a2ui-travel/catalog.json",
      "components": [
        {
          "id": "price",
          "component": "Text",
          "text": {
            "@call": "formatCurrency",
            "args": {
              "value": {
                "@path": "/trip/total"
              },
              "currency": "EUR"
            }
          }
        },
        {
          "id": "link",
          "component": "Button",
          "child": "link_child",
          "action": {
            "functionCall": {
              "@call": "openUrl",
              "args": {
                "url": "https://example.com/trip"
              }
            }
          }
        },
        {
          "id": "link_child",
          "component": "Text",
          "text": "Open"
        },
        {
          "id": "root",
          "component": "Column",
          "children": [
            "price",
            "link"
          ]
        }
      ]
    }
  }
]
