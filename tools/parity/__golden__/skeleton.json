{
  "search_flights": {
    "express": "surface(\"inline-1\")\nrows = Flights(\"Finding flights\", \"/trip/selectedFlight\")\nroot = Column([rows])",
    "opening": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "inline-1",
          "catalogId": "https://travel-a2ui.dev/catalogs/a2ui-travel/catalog.json",
          "components": [
            {
              "component": "Text",
              "id": "rows__text_1",
              "text": "### Finding flights",
              "variant": "body"
            },
            {
              "component": "FlightOption",
              "id": "rows__flightoption_1",
              "airline": {
                "@path": "airline"
              },
              "departTime": {
                "@path": "departTime"
              },
              "arriveTime": {
                "@path": "arriveTime"
              },
              "origin": {
                "@path": "origin"
              },
              "destination": {
                "@path": "destination"
              },
              "price": {
                "@path": "price"
              },
              "action": {
                "event": {
                  "name": "select_flight",
                  "userMessage": {
                    "@call": "formatString",
                    "args": {
                      "value": "Chose ${airline} ${flightNumber}, ${departTime} → ${arriveTime}, ${price}"
                    }
                  },
                  "context": {
                    "id": {
                      "@path": "id"
                    },
                    "price": {
                      "@path": "price"
                    },
                    "airline": {
                      "@path": "airline"
                    },
                    "flightNumber": {
                      "@path": "flightNumber"
                    },
                    "departTime": {
                      "@path": "departTime"
                    },
                    "arriveTime": {
                      "@path": "arriveTime"
                    }
                  }
                }
              },
              "duration": {
                "@path": "duration"
              },
              "stops": {
                "@path": "stops"
              },
              "flightNumber": {
                "@path": "flightNumber"
              },
              "total": {
                "@path": "total"
              },
              "badge": {
                "@path": "badge"
              },
              "selected": {
                "@call": "equals",
                "args": {
                  "a": {
                    "@path": "id"
                  },
                  "b": {
                    "@path": "/trip/selectedFlight"
                  }
                }
              },
              "accessibility": {
                "label": {
                  "@call": "formatString",
                  "args": {
                    "value": "${airline} ${flightNumber}, ${departTime} ${origin} to ${arriveTime} ${destination}, ${stops}, ${price} ${total}"
                  }
                }
              }
            },
            {
              "component": "List",
              "id": "rows__list_1",
              "children": {
                "path": "/flights",
                "componentId": "rows__flightoption_1"
              },
              "direction": "vertical",
              "align": "stretch"
            },
            {
              "component": "Column",
              "id": "rows",
              "children": [
                "rows__text_1",
                "rows__list_1"
              ],
              "justify": "start",
              "align": "stretch"
            },
            {
              "id": "root",
              "component": "Column",
              "children": [
                "rows"
              ]
            }
          ],
          "dataModel": {
            "trip": {
              "destination": "Madrid",
              "origin": "JFK",
              "startDate": "2027-04-12",
              "endDate": "2027-04-19",
              "travelers": 2
            },
            "plan": {
              "decisions": [
                {
                  "key": "destination",
                  "label": "where you are going",
                  "value": "Madrid",
                  "line": "where you are going — Madrid"
                },
                {
                  "key": "origin",
                  "label": "which airport you are flying from",
                  "value": "JFK",
                  "line": "which airport you are flying from — JFK"
                },
                {
                  "key": "startDate",
                  "label": "when you are leaving",
                  "value": "2027-04-12",
                  "line": "when you are leaving — 2027-04-12"
                },
                {
                  "key": "endDate",
                  "label": "when you are coming back",
                  "value": "2027-04-19",
                  "line": "when you are coming back — 2027-04-19"
                }
              ],
              "route": [
                {
                  "place": "Madrid",
                  "from": "JFK",
                  "nights": 7,
                  "detail": "7 nights · a ticket, somewhere to stay, things to do",
                  "line": "Madrid — 7 nights · a ticket, somewhere to stay, things to do",
                  "decisions": [
                    {
                      "key": "travelers",
                      "label": "who is on this hop",
                      "value": "2",
                      "line": "who is on this hop — 2"
                    }
                  ],
                  "wants": [
                    "a ticket",
                    "somewhere to stay",
                    "things to do"
                  ]
                }
              ],
              "caption": "5 decided · 1 hops · 1 open",
              "complete": false,
              "multiStop": false
            },
            "money": {}
          },
          "sendDataModel": true
        }
      }
    ],
    "path": "/flights",
    "filled": [
      {
        "version": "1.0",
        "updateDataModel": {
          "surfaceId": "inline-1",
          "path": "/flights",
          "value": [
            {
              "id": "IB6250",
              "airline": "Iberia",
              "flightNumber": "IB6250",
              "origin": "JFK",
