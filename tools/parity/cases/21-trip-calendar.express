head = Text("When you are going", variant="h3")
cal = TripCalendar($/trip/startDate, $/trip/endDate, marks=[{date: "2027-04-12", icon: "plane", label: "Fly out"}, {date: "2027-04-14", icon: "🎨", label: "Prado"}, {date: "2027-04-18", icon: "plane", label: "Fly home"}], title="Madrid", caption="6 nights", action=Event("change", {field: "startDate"}))
single = TripCalendar("2027-05-02", title="Day trip to Toledo")
root = Column([head, cal, single])
