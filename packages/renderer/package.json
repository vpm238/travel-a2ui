{
  "name": "@travel-a2ui/renderer",
  "version": "0.1.0",
  "description": "A React host for A2UI surfaces: the basic catalog plus the travel catalog.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
