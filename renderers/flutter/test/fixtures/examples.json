[
  {
    "example": "10-opening-form",
    "surfaceId": "inline-1",
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "inline-1",
          "catalogId": "https://travel-a2ui.dev/catalogs/a2ui-travel/catalog.json",
          "sendDataModel": true,
          "components": [
            {
              "id": "title",
              "component": "Text",
              "text": "### Madrid in April — two travellers"
            },
            {
              "id": "from",
              "component": "AirportPicker",
              "label": "Where from?",
              "value": {
                "@path": "/trip/origin"
              },
              "options": {
                "@path": "/places/origins"
              },
              "kind": "origin",
              "placeholder": "City or airport"
            },
            {
              "id": "dates",
              "component": "DateRangePicker",
              "label": "Travel dates",
              "start": {
                "@path": "/trip/startDate"
              },
              "end": {
                "@path": "/trip/endDate"
              },
              "nightsLabel": {
                "@call": "formatString",
                "args": {
                  "value": "${calcNights(start: ${/trip/startDate}, end: ${/trip/endDate})} nights"
                }
              }
            },
            {
              "id": "who",
              "component": "TravelerCounter",
              "label": "Travellers",
              "value": {
                "@path": "/trip/travelers"
              },
              "min": 1,
              "max": 8
            },
            {
              "id": "go_label",
              "component": "Text",
              "text": "Find flights"
            },
            {
              "id": "go",
              "component": "Button",
              "child": "go_label",
              "variant": "primary",
              "action": {
                "event": {
                  "name": "find_flights",
                  "userMessage": "Find flights for these dates"
                }
              }
            },
            {
              "id": "root",
              "component": "Column",
              "children": [
                "title",
                "from",
                "dates",
                "who",
                "go"
              ],
              "align": "stretch"
            }
          ]
        }
      },
      {
        "version": "1.0",
        "updateDataModel": {
          "surfaceId": "inline-1",
          "path": "/trip/origin",
          "value": "JFK"
        }
      },
      {
        "version": "1.0",
        "updateDataModel": {
          "surfaceId": "inline-1",
          "path": "/trip/startDate",
          "value": "2027-04-12"
        }
      },
      {
        "version": "1.0",
        "updateDataModel": {
          "surfaceId": "inline-1",
          "path": "/trip/endDate",
          "value": "2027-04-19"
        }
      },
      {
        "version": "1.0",
        "updateDataModel": {
          "surfaceId": "inline-1",
          "path": "/trip/travelers",
          "value": 2
        }
      }
    ]
  },
  {
    "example": "20-flight-options",
    "surfaceId": "inline-2",
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "inline-2",
          "catalogId": "https://travel-a2ui.dev/catalogs/a2ui-travel/catalog.json",
          "components": [
            {
              "component": "Text",
