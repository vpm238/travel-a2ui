            {
              "component": "Column",
              "id": "fares",
              "children": [
                "fares__text_1",
                "fares__list_1"
              ],
              "justify": "start",
              "align": "stretch"
            },
            {
              "id": "note",
              "component": "Text",
              "text": "Prices are per traveler, round trip."
            },
            {
              "id": "root",
              "component": "Column",
              "children": [
                "fares",
                "note"
              ]
            }
          ]
        }
