              "variant": "body"
            },
            {
              "component": "FlightOption",
              "id": "fares__flightoption_1",
              "accessibility": {
                "label": {
                  "@call": "formatString",
                  "args": {
                    "value": "${airline} ${flightNumber}, ${departTime} ${origin} to ${arriveTime} ${destination}, ${stops}, ${price} ${total}"
                  }
                }
              },
              "airline": {
                "@path": "airline"
              },
              "departTime": {
