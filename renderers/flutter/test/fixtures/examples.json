                    },
                    "airline": {
                      "@path": "airline"
                    },
                    "flightNumber": {
                      "@path": "flightNumber"
                    },
                    "departTime": {
                      "@path": "departTime"
                    },
                    "arriveTime": {
                      "@path": "arriveTime"
                    },
                    "from": {
                      "@path": "origin"
                    },
                    "to": {
                      "@path": "destination"
                    }
                  },
                  "userMessage": {
                    "@call": "formatString",
                    "args": {
                      "value": "Chose ${airline} ${flightNumber}, ${departTime} → ${arriveTime}, ${price}"
                    }
                  }
                }
              },
              "duration": {
                "@path": "duration"
              },
              "stops": {
