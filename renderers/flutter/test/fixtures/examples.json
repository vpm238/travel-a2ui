              "badge": {
                "@path": "badge"
              },
              "selected": {
                "@call": "equals",
                "args": {
                  "a": {
                    "@path": "id"
                  },
                  "b": {
                    "@path": "/trip/selectedFlight"
                  }
                }
              }
            },
            {
              "component": "List",
              "id": "fares__list_1",
