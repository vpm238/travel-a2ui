  {
    "example": "30-refine-search",
    "surfaceId": "inline-3",
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "inline-3",
          "catalogId": "https://travel-a2ui.dev/catalogs/a2ui-travel/catalog.json",
          "sendDataModel": true,
          "components": [
            {
              "id": "title",
              "component": "Text",
              "text": "### Refine"
            },
            {
              "id": "dates",
              "component": "DateRangePicker",
              "label": "Travel dates",
              "start": {
                "@path": "/filters/start"
              },
              "end": {
                "@path": "/filters/end"
              },
              "action": {
                "event": {
                  "name": "dates_changed"
                }
              },
              "nightsLabel": "6 nights"
            },
            {
              "id": "who",
              "component": "TravelerCounter",
              "label": "Adults",
              "value": {
                "@path": "/filters/adults"
              },
              "min": 1,
              "max": 8
            },
            {
              "id": "budget",
              "component": "Slider",
              "label": "Max fare",
              "min": 150,
              "max": 1500,
              "value": {
                "@path": "/filters/maxPrice"
              }
            },
            {
              "id": "stops",
              "component": "ChoicePicker",
              "label": "Stops",
              "variant": "mutuallyExclusive",
              "options": [
                {
                  "label": "Any",
                  "value": "any"
                },
                {
                  "label": "Nonstop only",
                  "value": "nonstop"
                }
              ],
              "value": {
                "@path": "/filters/stops"
              }
            },
            {
              "id": "apply",
              "component": "Button",
              "child": "apply_child",
              "variant": "primary",
              "action": {
                "event": {
                  "name": "apply_filters",
                  "context": {
                    "maxPrice": {
                      "@path": "/filters/maxPrice"
                    },
                    "adults": {
                      "@path": "/filters/adults"
                    },
                    "stops": {
                      "@path": "/filters/stops"
                    }
                  }
                }
              }
            },
            {
              "id": "apply_child",
              "component": "Text",
              "text": "Apply"
            },
            {
              "id": "root",
              "component": "Column",
              "children": [
                "title",
                "dates",
                "who",
                "budget",
                "stops",
                "apply"
              ],
              "align": "stretch"
            }
          ],
          "dataModel": {
            "filters": {
              "adults": 2,
              "maxPrice": 600
            }
          }
        }
      }
    ]
  },
